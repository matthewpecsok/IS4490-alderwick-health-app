{
  "name": "Alderwick Family Health",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "GOOGLE_GENAI_USE_VERTEXAI": "true"
  },
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "API key for Gemini (Google AI Studio or a GCP project). Used by clinic/gemini.py; test it at /dev/gemini/.",
      "documentationUrl": "https://ai.google.dev/gemini-api/docs/api-key"
    }
  },
  "updateContentCommand": "pip install --user -r requirements.txt",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Alderwick web app",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "batisteo.vscode-django"]
    }
  }
}
